# Production settings for https://genailog.vardaam.site (Plesk).
# Copy to .env on the server, fill in every CHANGE_ME, then follow
# docs/DEPLOY-PLESK.md. Never commit the real .env.

APP_NAME="GenAI Log"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://genailog.vardaam.site

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=warning

# PostgreSQL is required: the reports use Postgres SQL (FILTER, EXTRACT EPOCH).
DB_CONNECTION=pgsql
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=CHANGE_ME
DB_USERNAME=CHANGE_ME
DB_PASSWORD=CHANGE_ME

# No Redis needed: sessions and cache live in the database, nothing is queued.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
CACHE_STORE=database
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@genailog.vardaam.site"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Where prompt and answer bodies are stored, encrypted per tenant.
#   local — storage/app/private on this server (simplest on Plesk)
#   s3    — an S3 bucket; fill in the AWS_* values below
AIUL_BODY_DISK=local
#AWS_ACCESS_KEY_ID=
#AWS_SECRET_ACCESS_KEY=
#AWS_DEFAULT_REGION=
#AWS_BUCKET=

# The company slug. `aiul:provision-device` and the super admin seeder use it.
AIUL_TENANT=vardaam
AIUL_TENANT_NAME="Vardaam"
AIUL_SESSION_IDLE_MINUTES=30
