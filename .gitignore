# Secrets and certificates — never commit these. Present from day one.
*.pem
*.key
*.crt
*.cer
*.p12
*.pfx
dev-ca/
spool/

# Go build output
/agent/aiul
/agent/bin/

# PHP / Laravel
/backend/vendor/
/backend/node_modules/
/backend/.env
/backend/storage/*.key

# macOS
.DS_Store

# Local scratch
*.local

# Laravel
/backend/storage/framework/cache/data/
/backend/storage/logs/*.log
/backend/public/build/

# Build output: binaries and installer packages are built from source, never committed.
/dist/
*.pkg

# JetBrains project files: per-developer editor settings, not project state.
.idea/
